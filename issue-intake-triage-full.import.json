                "default": "text"
              }
            },
            "mcp_template": "microsoft-teams",
            "connection_id": "1d004ae3-9ad8-4190-845c-f3f714b3167c",
            "tool_input_schema": {
              "type": "object",
              "required": [
                "content"
              ],
              "properties": {
                "chat_id": {
                  "type": "string",
                  "description": "Existing chat ID from list_chats"
                },
                "content": {
                  "type": "string",
                  "description": "Message content"
                },
                "user_email": {
                  "type": "string",
                  "description": "Recipient email for a 1:1 chat (used when chat_id is omitted)"
                },
                "content_type": {
                  "enum": [
                    "text",
                    "html"
                  ],
                  "type": "string",
