          "next": "_end",
          "type": "code",
          "config": {
            "name": "Noise ack",
            "code": "def run(inputs: Inputs) -> Outputs:\n    return {\"response\": \"Classified as NOISE. No action taken.\"}\n",
            "input_fields": {},
