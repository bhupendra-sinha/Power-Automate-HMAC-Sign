                }
              }
            }
          }
        },
        {
          "id": "build_clarify",
          "next": "reply_clarify",
          "type": "code",
          "config": {
            "name": "Build clarify ask",
            "code": "def run(inputs: Inputs) -> Outputs:\n    summary = (inputs.summary or \"\").strip()\n    body = (\n        \"\\U0001F916 This looks like it might be an issue, but I need a bit more \"\n        \"detail to log it: which system, what you saw (error text or screenshot), \"\n        \"and the steps to reproduce.\"\n    )\n    if summary:\n        body = body + \"\\n\\nWhat I understood so far: \" + summary\n    return {\"response\": body}\n",
            "input_fields": {
              "summary": {
                "type": "string",
                "source": "triage.summary"
              }
            },
            "output_fields": {
              "response": {
                "type": "string",
                "description": "Clarify request to post back into Teams"
              }
            }
          }
        },
        {
          "id": "reply_clarify",
          "next": "_end",
          "type": "tool",
          "config": {
            "name": "Reply clarify in Teams",
            "tool_name": "send_chat_message",
            "input_fields": {
              "chat_id": {
                "source": "input.conversation_id"
              },
              "content": {
                "source": "build_clarify.response"
              },
              "content_type": {
                "default": "text"
              }
            },
            "mcp_template": "microsoft-teams",
            "connection_id": "1d004ae3-9ad8-4190-845c-f3f714b3167c",
            "tool_input_schema": {
              "type": "object",
              "required": [
