# Copy to .env and fill in. Never commit .env.

# MagOneAI base URL (local API). Hook path defaults to /api/v1/hooks.
MAGONE_BASE_URL=http://localhost:8000
MAGONE_HOOK_PATH=/api/v1/hooks

# From the Credentials page (shown once at key creation):
API_KEY_ID=paste-key-id-here
API_KEY_SECRET=magk_paste-secret-here

# The use case to trigger (slug or id). Must be PUBLISHED.
USE_CASE_ID=issue-intake-triage-mvp

# Shared secret between Power Automate and this shim (invent a long random string).
SHARED_SECRET=change-me-to-a-long-random-string

# Port the shim listens on (kept off 8000/9000 to avoid clashes).
PORT=8790

# --- Inline Teams image fetch (optional) ---
# Reuse the SAME delegated OAuth app + refresh token the Teams MCP uses, so the
# shim can pull pasted screenshots (hostedContents) without admin consent.
# Leave blank to run text-only (images are silently skipped).
TENANT_ID=
CLIENT_ID=
# Omit for a public client (no secret); set for a confidential client.
CLIENT_SECRET=
TEAMS_REFRESH_TOKEN=
# Usually leave as-is; inherits the scopes already consented to the MCP app.
GRAPH_SCOPE=https://graph.microsoft.com/.default